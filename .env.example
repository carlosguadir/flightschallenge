NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flight:flight@db:5432/flight
COOKIE_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=1
SEAT_HOLD_TTL_SECONDS=300
MAX_HOLDS_PER_FLIGHT=4
PAYMENT_DELAY_MS=300
PG_POOL_MAX=20
LOCK_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=10000
THROTTLE_ENABLED=true
THROTTLE_LIMIT=100
THROTTLE_TTL_SECONDS=60
METRICS_BATCH_MS=75
LOG_LEVEL=info
LOG_PRETTY=false
APP_VERSION=dev
# Only exposed when NODE_ENV=test|e2e; used by the Playwright reset hook.
TEST_RESET_TOKEN=
# Swagger UI at /api/docs; defaults to true outside production.
SWAGGER_ENABLED=true
