# Values used only by the Playwright profile. The e2e stack runs in its own
# compose project (flight-e2e) so it can coexist with the development stack.
BACKEND_NODE_ENV=e2e
SEAT_HOLD_TTL_SECONDS=5
PAYMENT_DELAY_MS=50
PG_POOL_MAX=10
THROTTLE_ENABLED=false
METRICS_BATCH_MS=25
LOG_LEVEL=warn
TEST_RESET_TOKEN=e2e-reset-token
FRONTEND_PORT=8081
